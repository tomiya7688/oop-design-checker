<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <AssemblyName>OopDesignChecker.Gui.HeadlessTests</AssemblyName>
    <RootNamespace>OopDesignChecker.Gui.HeadlessTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <ProjectReference Include="../../src/frontends/gui/OopDesignChecker.Gui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Baselines/**/*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
