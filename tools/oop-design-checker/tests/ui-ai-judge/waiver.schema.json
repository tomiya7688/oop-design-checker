{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI AI Review Waiver",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario",
    "reason",
    "approvedBy"
  ],
  "properties": {
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "approvedBy": {
      "type": "string",
      "minLength": 1
    },
    "reference": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
